# Copy to .env. Read by docker compose and by the app when run outside Docker.

# --- docker compose: the local postgres container ---
POSTGRES_USER=wysebee
POSTGRES_PASSWORD=wysebee
POSTGRES_DB=wysebee
POSTGRES_PORT=5432
WEB_PORT=8000

# This app's public URL, when it is exposed through a tunnel (`./scripts/ngrok.sh`). Only
# the tunnel script reads it; the Auth0 applications must list its callbacks (below).
# Development tunnel:  CLOUD_PUBLIC_URL=https://<your-tunnel>.ngrok.dev

# --- the app (prefix WYSEBEE_) ---
# Running `uv run uvicorn ...` on the host against the compose db:
WYSEBEE_DATABASE_URL=postgresql+psycopg://wysebee:wysebee@localhost:5432/wysebee
# Azure Database for PostgreSQL (flexible server) — SSL is required:
# WYSEBEE_DATABASE_URL=postgresql+psycopg://<user>:<password>@<server>.postgres.database.azure.com:5432/<db>?sslmode=require
WYSEBEE_LOG_LEVEL=info
# Sign-in: an Auth0 tenant (README, "Sign-in (Auth0)"). All empty = sign-in off.
# The issuer is the tenant's domain (or custom domain) as a URL; a trailing "/" is added.
# WYSEBEE_AUTH_ISSUER=https://<tenant>.us.auth0.com/
# The Auth0 API's identifier — requested as `audience`, checked in every token's `aud`.
# WYSEBEE_AUTH_AUDIENCE=https://wysebee.ai/api
# This site's Auth0 application (Single Page Application): its Client ID. A public value.
# WYSEBEE_AUTH_WEB_CLIENT_ID=
# Only if the keys are not at <issuer>.well-known/jwks.json:
# WYSEBEE_AUTH_JWKS_URL=
# Local development without Auth0: this app is its own sign-in provider at
# http://localhost:8000/mock-auth/ — no password, you sign in as whoever you type. Leave the
# WYSEBEE_AUTH_* above empty (they default to local values); refused off localhost.
# WYSEBEE_AUTH_MOCK=true
# With it on, try Wysebee from Claude or ChatGPT (Write with AI, your agents): /assistant/mcp answers
# WITHOUT SIGN-IN as this person (refused without WYSEBEE_AUTH_MOCK, so never on Dev or Prod).
# Run ./scripts/ngrok.sh and set WYSEBEE_PUBLIC_URL to CLOUD_PUBLIC_URL, so the editor shows
# the tunnel's address to add to the AI app.
# WYSEBEE_ASSISTANT_MCP_LOCAL_USER=mock|dev@wysebee.local
# WYSEBEE_PUBLIC_URL=https://<your-tunnel>.ngrok.dev
# The Azure Blob Storage account the file stores (assets, skill files, workspaces) use, signed
# in with the app's managed identity (production; see the README). Also read from
# WYSEBEE_BACKUP_AZURE_ACCOUNT_URL, the name deployments set while desktop backups were kept.
# WYSEBEE_STORAGE_AZURE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# Assets (PUT/GET/DELETE /api/v1/assets: small images, agents' pictures). Where they are
# written: "file" (default) under WYSEBEE_ASSET_DIR — compose mounts a volume at
# /data/assets — or "azure", one blob each in its own container (skill files and workspaces
# follow the same choice). The account defaults to WYSEBEE_STORAGE_AZURE_ACCOUNT_URL's. Per
# upload the largest size, per person how many may be kept.
# WYSEBEE_ASSET_STORE=file
# WYSEBEE_ASSET_DIR=./data/assets
# WYSEBEE_ASSET_AZURE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# WYSEBEE_ASSET_AZURE_CONTAINER=user-assets
# WYSEBEE_ASSET_MAX_BYTES=1048576
# WYSEBEE_ASSET_MAX_COUNT=100
# Auth0's Management API, to delete a person's account (README, DELETE /api/v1/account): the
# tenant's own *.auth0.com domain and a machine-to-machine application allowed delete:users alone.
# Unset: accounts cannot be deleted, unless WYSEBEE_AUTH_MOCK is on.
# WYSEBEE_AUTH0_MGMT_DOMAIN=
# WYSEBEE_AUTH0_MGMT_CLIENT_ID=
# WYSEBEE_AUTH0_MGMT_CLIENT_SECRET=
# Extensions to load (apps/cloud/extensions.py), comma-separated: what a deployment adds that
# is not in this repository, e.g. the hosted service's plans. Their own settings are theirs.
# WYSEBEE_EXTENSIONS=
# Usage events from the site's own pages (the landing page and the web app at /app/): kept in
# the usage_events table, and forwarded to Mixpanel when a token is set. Empty token = kept
# here only (dev, local). API host only for an EU-resident project.
# WYSEBEE_EVENTS_ENABLED=true
# WYSEBEE_EVENTS_RETENTION_DAYS=395
# WYSEBEE_EVENTS_BATCHES_PER_MINUTE=30
WYSEBEE_MIXPANEL_TOKEN=
# WYSEBEE_MIXPANEL_API_HOST=https://api-eu.mixpanel.com
# Run `alembic upgrade head` when the container starts (default true).
WYSEBEE_MIGRATE_ON_START=true
