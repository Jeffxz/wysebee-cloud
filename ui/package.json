{
  "name": "wysebee-cloud-ui",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.38.0",
  "type": "module",
  "scripts": {
    "dev": "vite -c cloud/vite.config.ts",
    "dev:app": "vite -c app/vite.config.ts",
    "dev:coverage": "WYSEBEE_E2E_COVERAGE=1 vite -c cloud/vite.config.ts",
    "dev:app:coverage": "WYSEBEE_E2E_COVERAGE=1 vite -c app/vite.config.ts",
    "build": "tsc -b && vite build -c cloud/vite.config.ts && vite build -c app/vite.config.ts",
    "preview": "vite preview -c cloud/vite.config.ts",
    "check:locales": "node scripts/check-locales.mjs",
    "test": "vitest run",
    "coverage:report": "node scripts/coverage-report.mjs",
    "coverage:clean": "node scripts/coverage-report.mjs --clean"
  },
  "dependencies": {
    "@dicebear/core": "9.4.2",
    "@dicebear/glass": "9.4.2",
    "@dicebear/lorelei": "9.4.2",
    "@dicebear/notionists": "9.4.2",
    "@dicebear/open-peeps": "9.4.2",
    "@dicebear/pixel-art": "9.4.2",
    "@dicebear/rings": "9.4.2",
    "@dicebear/shapes": "9.4.2",
    "@dicebear/thumbs": "9.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@observablehq/plot": "^0.6.17",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "i18next": "^26.3.6",
    "lucide-react": "^1.17.0",
    "oidc-client-ts": "3.5.0",
    "qrcode-generator": "1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.10",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "2.1.9",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-lib-source-maps": "5.0.6",
    "istanbul-reports": "3.2.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-istanbul": "6.0.2",
    "vitest": "2.1.9"
  }
