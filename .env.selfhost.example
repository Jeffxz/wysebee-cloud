# Self-hosted Wysebee Cloud (docker-compose.selfhost.yml, docs/self-hosting.md).
# Copy to .env.selfhost and fill in. Keep the copy private: it holds your secrets.

# The database's password: any long random string (`openssl rand -base64 24`).
POSTGRES_PASSWORD=

# 32 random bytes, base64 (`openssl rand -base64 32`): the key agents' database passwords are
# sealed under. Back it up; a new key cannot open what the old one sealed.
WYSEBEE_AI_KEK=

# Who you are, as the pages show it.
WYSEBEE_SELFHOST_USER_NAME=Owner
WYSEBEE_SELFHOST_USER_EMAIL=

# A shared secret the web app and AI apps must send (`openssl rand -base64 32`). Leave empty
# only while the server is reachable from this machine alone.
WYSEBEE_SELFHOST_TOKEN=

# Where the port is published: 127.0.0.1 (this machine only) or 0.0.0.0 (your network — set
# WYSEBEE_SELFHOST_TOKEN first, and put HTTPS in front for anything beyond your LAN).
WEB_BIND=127.0.0.1
WEB_PORT=8000

# The address agents and AI apps reach it at, e.g. https://wysebee.example.com (optional).
WYSEBEE_PUBLIC_URL=
